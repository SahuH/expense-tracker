# ─── Domain ────────────────────────────────────────────────────────────────────
# Your public domain pointing to the Oracle VM IP
DOMAIN=finance.example.com

# ─── Timezone ──────────────────────────────────────────────────────────────────
TIMEZONE=Asia/Dubai

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=firefly
POSTGRES_USER=firefly
POSTGRES_PASSWORD=change_me_strong_password

# ─── Firefly III ───────────────────────────────────────────────────────────────
# Generate with: php artisan key:generate --show  (or any 32-char random string)
FIREFLY_APP_KEY=change_me_32_char_random_string_here

# Generated from Firefly III UI after first login:
# Profile → OAuth → Personal Access Tokens → Create new token
FIREFLY_ACCESS_TOKEN=change_me_after_first_firefly_login

# ─── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-change_me

# ─── Streamlit Auth ────────────────────────────────────────────────────────────
# These are used by scripts/setup_firefly.py and for reference.
# Actual hashed credentials live in streamlit/config.yaml
# Generate hashes with: python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
STREAMLIT_USER_HARSH_PASSWORD=change_me_harsh_password
STREAMLIT_USER_WIFE_PASSWORD=change_me_wife_password
