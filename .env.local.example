# Local development values — copy to .env
DOMAIN=localhost
TIMEZONE=Asia/Dubai

POSTGRES_DB=firefly
POSTGRES_USER=firefly
POSTGRES_PASSWORD=localdev_password

# Generate with: openssl rand -base64 32 | tr -d '\n'
FIREFLY_APP_KEY=

# Fill in after first Firefly login (Step 5 below)
FIREFLY_ACCESS_TOKEN=

# Optional — only needed for the Ask AI page
# ANTHROPIC_API_KEY=sk-ant-your-key-here
